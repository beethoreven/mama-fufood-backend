# 複製成 .env 再填。.env 不進 git。正式環境的值設在 Render 的環境變數,不用這個檔。
DATABASE_URL=postgresql://postgres@localhost:5433/mff_dev
# Google Cloud 的「網頁應用程式」用戶端 ID。App 登入時的 serverClientId 也是這一個。
GOOGLE_CLIENT_ID=
# 管理後台網頁的來源,逗號分隔,不要結尾斜線。
ALLOWED_ORIGINS=http://localhost:8003
FIRST_ADMIN_EMAIL=
# 管理後台 session 的簽章金鑰,隨便一串夠長的亂數(例如 python3 -c "import secrets; print(secrets.token_hex(32))")。
SESSION_SECRET=
